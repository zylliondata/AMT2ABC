        "script": "var conds = [];\nvar kw = String(KeywordInput?.value || '').trim();\nvar lot = String(LotBatchInput?.value || '').trim();\nvar loc = String(LocationInput?.value || '').trim();\nvar ar = String(AreaInput?.value || '').trim();\nvar st = String(StatusSelect?.value || '').trim();\nvar mt = String(MatTypeSelect?.value || '').trim();\nif (kw) conds.push({condition:'like', columnName:'item', columnValue:kw});\nif (lot) conds.push({condition:'=', columnName:'lot_batch_number', columnValue:lot});\nif (loc) conds.push({condition:'=', columnName:'location', columnValue:loc});\nif (ar) conds.push({condition:'=', columnName:'area', columnValue:ar});\nif (st) conds.push({condition:'=', columnName:'status', columnValue:st});\nif (mt) conds.push({condition:'=', columnName:'material_definition_type', columnValue:mt});\ncv_invQFilter.setValue(conds);\nif (ResultTable && ResultTable.setPage) { ResultTable.setPage(1); }\nawait eca_invQSearch.run();"
